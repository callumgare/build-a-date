root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
# For editors' rulers. Biome ignores this key (it isn't in the EditorConfig spec), so
# biome.json repeats it as formatter.lineWidth: keep the two in step.
max_line_length = 120

[*.md]
trim_trailing_whitespace = false
