{
  "name": "build-a-date",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && CLOUDFLARE_ENV= opennextjs-cloudflare deploy",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply build-a-date --local",
    "db:migrate:remote": "CLOUDFLARE_ENV= wrangler d1 migrations apply build-a-date --remote",
    "db:migrate:e2e": "wrangler d1 migrations apply build-a-date-e2e --local --env e2e --persist-to .wrangler/e2e",
    "auth:generate": "auth generate --config src/lib/auth-cli.ts --output src/db/auth-schema.ts --yes",
    "format": "biome check --write ."
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.5",
    "@opennextjs/cloudflare": "1.20.6",
    "better-auth": "1.7.5",
    "drizzle-orm": "0.45.3",
    "motion": "13.4.2",
    "nanoid": "6.0.1",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "auth": "1.7.5",
    "better-sqlite3": "13.0.3",
    "drizzle-kit": "0.31.11",
    "jsdom": "30.1.1",
    "typescript": "6.0.3",
    "vitest": "5.0.1",
    "wrangler": "4.137.0"
  }
}
