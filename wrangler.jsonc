{
  "name": "build-a-date",
  "compatibility_date": "2026-09-24",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "build-a-date.oncal.link", "custom_domain": true }
  ]
}